{
  "name": "@interface-ai/automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "browserbase:check": "node --env-file-if-exists=.env --import tsx src/browserbase/cli.ts",
    "browserbase:spike": "node --env-file-if-exists=.env --import tsx src/browserbase/spike-cli.ts",
    "browserbase:portal-check": "node --env-file-if-exists=.env --import tsx src/browserbase/portal-check.ts",
    "executor:check": "node --env-file-if-exists=.env --import tsx src/execution/check-cli.ts"
  },
  "dependencies": {
    "@interface-ai/contracts": "workspace:*",
    "express": "catalog:",
    "zod": "catalog:",
    "@browserbasehq/stagehand": "catalog:",
    "@interface-ai/postgres": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "tsx": "catalog:"
  }
}
