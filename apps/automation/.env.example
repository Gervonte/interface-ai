# Optional automation API bind configuration.
HOST=127.0.0.1
PORT=3001

# Server-only Browserbase configuration. Never use frontend VITE_* variables.
# Copy this file to apps/automation/.env and fill in credentials locally.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Set to the current fixture tunnel's HTTPS URL; include /compatibility.
BROWSERBASE_FIXTURE_URL=
# Full staff portal check: current public HTTPS root (no /compatibility).
BROWSERBASE_PORTAL_URL=

# pnpm db:up writes this app's private runtime URL and fingerprint key to .env.
DATABASE_URL=
REQUEST_FINGERPRINT_KEY=

# pnpm automation:configure generates the server-only local operator token.
AUTOMATION_API_TOKEN=
# Optional paired absolute config-file paths; both must be set together.
# Defaults: committed target.v2.json and policy.v2.json.
AUTOMATION_TARGET_FILE=
AUTOMATION_POLICY_FILE=
