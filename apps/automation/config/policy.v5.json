{
  "id": "demo-policy",
  "version": 5,
  "allowedOrigins": [
    "http://127.0.0.1:3002"
  ],
  "allowedActions": [
    "navigate",
    "fill",
    "click",
    "wait",
    "capture",
    "intervene"
  ],
  "allowRiskyActions": false,
