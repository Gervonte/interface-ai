{
  "name": "interface-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26.2.0 <27",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "pnpm --filter @interface-ai/contracts build && concurrently --kill-others --names automation,operator,demo-api,demo-web \"pnpm --filter @interface-ai/automation dev\" \"pnpm --filter @interface-ai/operator dev\" \"pnpm --filter @interface-ai/demo-api dev\" \"pnpm --filter @interface-ai/demo-web dev\"",
    "dev:automation": "pnpm --filter @interface-ai/contracts build && pnpm --filter @interface-ai/automation dev",
    "dev:operator": "pnpm --filter @interface-ai/contracts build && pnpm --filter @interface-ai/operator dev",
    "dev:demo-api": "pnpm --filter @interface-ai/contracts build && pnpm --filter @interface-ai/demo-api dev",
    "dev:demo-web": "pnpm --filter @interface-ai/contracts build && pnpm --filter @interface-ai/demo-web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @interface-ai/contracts build && tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "test": "pnpm --filter @interface-ai/contracts build && vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev:fixture": "pnpm --filter @interface-ai/demo-api fixture",
    "browserbase:check": "pnpm --filter @interface-ai/contracts build && pnpm --filter @interface-ai/automation browserbase:check"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "concurrently": "10.0.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@interface-ai/contracts": "workspace:*"
  }
}
